{
  "name": "@context-space/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings src tests",
    "typecheck": "tsc -b --pretty false",
