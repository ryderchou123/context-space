{
  "manifest_version": 3,
  "name": "Context Space",
  "version": "0.1.0",
  "description": "Save, switch, and restore local browser workspace tabs.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47651/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Context Space", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "128": "icons/128.png" }
}
